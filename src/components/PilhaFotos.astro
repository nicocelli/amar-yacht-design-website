---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Coleção de fotos empilhada, como um maço de cópias sobre a mesa.
 *
 * Em repouso as bordas das cartas de trás aparecem — é isso que anuncia que há
 * mais de uma foto. Com o cursor sobre a pilha ela avança sozinha, trazendo as
 * de trás para a frente. Em telas sem hover, avança devagar enquanto estiver
 * visível. O botão que cobre a pilha dá o mesmo avanço por clique, toque e
 * teclado, e é ele que carrega o rótulo para leitor de tela.
 */
interface Props {
  fotos: { src: ImageMetadata; alt: string }[];
  class?: string;
}

const { fotos, class: className = '' } = Astro.props;
---

<div class:list={['pilha relative', className]} data-pilha>
  <ul class="absolute inset-0 m-0 list-none p-0">
    {
      fotos.map((foto, i) => (
        <li
          class="pilha-carta absolute inset-[4%] overflow-hidden rounded-media bg-sand shadow-[0_14px_40px_-22px_rgba(14,42,61,0.38)]"
          data-carta
          data-pos={i}
        >
          <Image
            src={foto.src}
            alt={foto.alt}
            widths={[480, 720, 1040]}
            sizes="(min-width: 1024px) 38vw, 88vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="size-full object-cover"
          />
        </li>
      ))
    }
  </ul>

  <button
    type="button"
    data-pilha-avanca
    class="absolute inset-[4%] z-50 cursor-pointer rounded-media"
  >
    <span class="sr-only">Ver a próxima foto da coleção</span>
  </button>
</div>

<style>
  .pilha-carta {
    outline: 4px solid var(--color-limestone);
    transition:
      transform 750ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 750ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: 50% 60%;
  }

  /* Maço arrumado: a foto da frente fica reta e as de trás escalonam sempre para
     o mesmo lado. Alternar o sentido da rotação serrilhava a silhueta. */
  .pilha-carta[data-pos='0'] {
    transform: rotate(0deg);
    z-index: 40;
  }
  .pilha-carta[data-pos='1'] {
    transform: rotate(1.4deg) translate(3.2%, 2.2%) scale(0.982);
    z-index: 30;
  }
  .pilha-carta[data-pos='2'] {
    transform: rotate(2.8deg) translate(6.2%, 4.4%) scale(0.964);
    z-index: 20;
  }
  .pilha-carta[data-pos='3'] {
    transform: rotate(4.2deg) translate(9%, 6.6%) scale(0.946);
    z-index: 10;
  }

  /* a carta que sai desliza para fora antes de voltar ao fundo do maço */
  .pilha-carta[data-saindo] {
    transform: rotate(-4deg) translate(-7%, -2.5%) scale(1.01);
    z-index: 50;
  }

  .pilha:focus-within .pilha-carta[data-pos='0'],
  .pilha:hover .pilha-carta[data-pos='0'] {
    transform: rotate(0deg) scale(1.012);
  }

  @media (prefers-reduced-motion: reduce) {
    .pilha-carta {
      transition: none;
    }
  }
</style>

<script>
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)');
  const semHover = window.matchMedia('(hover: none)');

  for (const pilha of document.querySelectorAll<HTMLElement>('[data-pilha]')) {
    const cartas = [...pilha.querySelectorAll<HTMLElement>('[data-carta]')];
    const botao = pilha.querySelector<HTMLButtonElement>('[data-pilha-avanca]');
    if (cartas.length < 2 || !botao) continue;

    let topo = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const pintar = () => {
      cartas.forEach((carta, i) => {
        carta.dataset.pos = String((i - topo + cartas.length) % cartas.length);
      });
    };

    const avancar = () => {
      const saindo = cartas[topo]!;
      // marca a carta da frente para ela levantar antes de ir ao fundo do maço
      saindo.dataset.saindo = '';
      topo = (topo + 1) % cartas.length;
      pintar();
      window.setTimeout(() => delete saindo.dataset.saindo, semMovimento.matches ? 0 : 190);
    };

    const parar = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    const rodar = (intervalo: number) => {
      parar();
      timer = setInterval(avancar, intervalo);
    };

    pintar();
    botao.addEventListener('click', avancar);

    if (!semMovimento.matches) {
      if (semHover.matches) {
        // sem cursor: gira devagar, e só enquanto a pilha está na tela
        new IntersectionObserver(
          ([entrada]) => (entrada!.isIntersecting ? rodar(4200) : parar()),
          { threshold: 0.4 },
        ).observe(pilha);
      } else {
        pilha.addEventListener('pointerenter', () => {
          avancar();
          rodar(1500);
        });
        pilha.addEventListener('pointerleave', parar);
        botao.addEventListener('focus', () => rodar(2200));
        botao.addEventListener('blur', parar);
      }
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) parar();
      });
    }
  }
</script>
