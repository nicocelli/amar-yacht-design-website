---
import SectionHead from '../SectionHead.astro';
import { principios, usos } from '../../data/site';
---

<section id="metodo" class="wrap py-section">
  <div class="grid gap-x-16 gap-y-12 lg:grid-cols-12">
    <SectionHead
      eyebrow="Nossa forma de projetar"
      title="Design que começa pela experiência."
      class="lg:col-span-5"
    />

    <div class="lg:col-span-6 lg:col-start-7 lg:pt-2">
      <p class="lede reveal">
        Antes de escolher materiais ou definir acabamentos, buscamos compreender como o
        proprietário utiliza sua embarcação.
      </p>

      <ul class="reveal mt-10 flex flex-wrap gap-x-3 gap-y-3" style="--reveal-delay:120ms">
        {
          usos.map((uso) => (
            <li class="rounded-full border border-taupe/50 px-4 py-2 font-sans text-[0.8125rem] text-graphite/80">
              {uso}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mt-24 lg:mt-28">
    <p class="display-md reveal max-w-[34ch] text-ocean">
      Cada forma de viver o barco exige decisões diferentes. Por isso, nossos projetos partem de
      três princípios.
    </p>

    <ol class="mt-14 grid gap-x-12 gap-y-14 sm:grid-cols-3">
      {
        principios.map((p, i) => (
          <li class="reveal rule-t pt-8" style={`--reveal-delay:${i * 110}ms`}>
            <span class="eyebrow text-ocean/45 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display-md mt-5">{p.title}</h3>
            <p class="mt-4 text-[0.9375rem] leading-relaxed text-graphite/80">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
