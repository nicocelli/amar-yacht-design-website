---
import SectionHead from '../SectionHead.astro';
import { contact, tiposDeProjeto, brand } from '../../data/site';

const waDirect = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(
  'Olá! Vim pelo site da A·MAR e gostaria de conversar sobre um projeto.',
)}`;
---

<section id="contato" class="wrap py-section">
  <div class="grid gap-x-16 gap-y-16 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <SectionHead eyebrow="Contato" title="Vamos conversar sobre a sua embarcação." />

      <p class="reveal mt-8 max-w-[42ch] text-graphite/85" style="--reveal-delay:100ms">
        Conte um pouco sobre o barco e sobre como você o utiliza. Respondemos com os próximos
        passos e o que é necessário para começar.
      </p>

    </div>

    <div class="reveal lg:col-span-6 lg:col-start-7">
      <form id="briefing" class="space-y-8" novalidate>
        <div class="grid gap-8 sm:grid-cols-2">
          <div class="flex flex-col">
            <label for="f-nome" class="eyebrow">Nome *</label>
            <input
              id="f-nome"
              name="nome"
              type="text"
              required
              autocomplete="name"
              class="mt-3 border-b border-taupe/60 bg-transparent pb-3 font-display text-xl font-light text-ocean placeholder:text-ink-muted focus:border-ocean focus:outline-none"
              placeholder="Como podemos te chamar"
            />
          </div>

          <div class="flex flex-col">
            <label for="f-barco" class="eyebrow">Embarcação</label>
            <input
              id="f-barco"
              name="barco"
              type="text"
              class="mt-3 border-b border-taupe/60 bg-transparent pb-3 font-display text-xl font-light text-ocean placeholder:text-ink-muted focus:border-ocean focus:outline-none"
              placeholder="Modelo e tamanho"
            />
          </div>
        </div>

        <div class="flex flex-col">
          <label for="f-tipo" class="eyebrow">Tipo de projeto *</label>
          <select
            id="f-tipo"
            name="tipo"
            required
            class="mt-3 appearance-none border-b border-taupe/60 bg-transparent pb-3 font-display text-xl font-light text-ocean focus:border-ocean focus:outline-none"
          >
            <option value="">Selecione</option>
            {tiposDeProjeto.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>

        <div class="flex flex-col">
          <label for="f-msg" class="eyebrow">Como você vive o barco?</label>
          <textarea
            id="f-msg"
            name="mensagem"
            rows="3"
            class="mt-3 resize-y border-b border-taupe/60 bg-transparent pb-3 font-display text-xl leading-relaxed font-light text-ocean placeholder:text-ink-muted focus:border-ocean focus:outline-none"
            placeholder="Finais de semana em família, viagens longas, receber amigos…"></textarea>
        </div>

        <p id="briefing-erro" role="alert" hidden class="font-sans text-[0.8125rem] text-ocean">
          Preencha o nome e o tipo de projeto para continuar.
        </p>

        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 pt-2">
          <button
            type="submit"
            class="group inline-flex items-center gap-3 rounded-full bg-ocean px-8 py-4 font-sans text-[0.6875rem] uppercase tracking-[0.2em] text-limestone transition-colors duration-300 hover:bg-ocean-deep"
          >
            Enviar pelo WhatsApp
            <svg width="16" height="8" viewBox="0 0 16 8" fill="none" aria-hidden="true"
              class="transition-transform duration-300 group-hover:translate-x-1">
              <path d="M0 4h14M11 1l3 3-3 3" stroke="currentColor" stroke-width="1"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  <dl class="reveal mt-20 grid gap-x-12 gap-y-8 rule-t pt-10 sm:grid-cols-3 lg:mt-24">
    <div>
      <dt class="eyebrow">WhatsApp</dt>
      <dd class="mt-3">
        <a
          href={waDirect}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display text-2xl font-light text-ocean underline decoration-taupe underline-offset-[6px] transition-colors [font-variant-numeric:lining-nums] hover:decoration-ocean"
        >
          {contact.phoneDisplay}
        </a>
      </dd>
    </div>

    <div>
      <dt class="eyebrow">Instagram</dt>
      <dd class="mt-3">
        <a
          href={contact.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display text-2xl font-light text-ocean underline decoration-taupe underline-offset-[6px] transition-colors hover:decoration-ocean"
        >
          {contact.instagramHandle}
        </a>
      </dd>
    </div>

    <div>
      <dt class="eyebrow">{contact.email ? 'E-mail' : 'Atendimento'}</dt>
      <dd class="mt-3">
        {
          contact.email ? (
            <a
              href={`mailto:${contact.email}`}
              class="font-display text-2xl font-light text-ocean underline decoration-taupe underline-offset-[6px] transition-colors hover:decoration-ocean"
            >
              {contact.email}
            </a>
          ) : (
            <span class="font-display text-2xl font-light text-ocean">{brand.location}</span>
          )
        }
      </dd>
    </div>
  </dl>
</section>

<script>
  import { contact } from '../../data/site';

  const form = document.getElementById('briefing') as HTMLFormElement | null;
  const erro = document.getElementById('briefing-erro');
  if (form && erro) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();

      const nome = get('nome');
      const tipo = get('tipo');

      if (!nome || !tipo) {
        erro.hidden = false;
        (form.querySelector(nome ? '#f-tipo' : '#f-nome') as HTMLElement | null)?.focus();
        return;
      }
      erro.hidden = true;

      const linhas = [
        'Olá, A·MAR! Vim pelo site.',
        '',
        `Nome: ${nome}`,
        `Tipo de projeto: ${tipo}`,
      ];

      const barco = get('barco');
      if (barco) linhas.push(`Embarcação: ${barco}`);

      const mensagem = get('mensagem');
      if (mensagem) linhas.push('', `Como vivo o barco: ${mensagem}`);

      window.open(
        `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(linhas.join('\n'))}`,
        '_blank',
        'noopener',
      );
    });
  }
</script>
