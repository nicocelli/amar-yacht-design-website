---
/**
 * Espaço reservado para fotografia real do estúdio.
 *
 * Enquanto não houver imagem, renderiza um campo de cor da paleta com grão —
 * a página fica visualmente completa em vez de quebrada. Para publicar uma foto:
 * coloque o arquivo em src/assets/, importe e passe em `src`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** Legenda do enquadramento desejado — some assim que a foto entra. */
  hint?: string;
  tone?: 'ocean' | 'sand' | 'oak' | 'sage';
  class?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
}

const {
  src,
  alt = '',
  hint,
  tone = 'ocean',
  class: className = '',
  loading = 'lazy',
  sizes = '(min-width: 1024px) 50vw, 100vw',
} = Astro.props;

const fields: Record<string, string> = {
  ocean: 'linear-gradient(155deg, #0E2A3D 0%, #12384f 46%, #081c2a 100%)',
  sand: 'linear-gradient(155deg, #E7E1D6 0%, #d8d0c2 55%, #B9B2A6 100%)',
  oak: 'linear-gradient(155deg, #D2C4AC 0%, #c6b59a 55%, #B9B2A6 100%)',
  sage: 'linear-gradient(155deg, #8FA08E 0%, #7d8f7d 55%, #5f6f60 100%)',
};

const onDark = tone === 'ocean' || tone === 'sage';
---

<figure class:list={['relative overflow-hidden rounded-media bg-sand', className]}>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        loading={loading}
        decoding="async"
        widths={[640, 960, 1440, 1920]}
        sizes={sizes}
        class="size-full object-cover"
      />
    ) : (
      <div class="absolute inset-0" style={`background:${fields[tone]}`} aria-hidden="true">
        {/* grão sutil, evita o aspecto de gradiente chapado */}
        <svg class="size-full opacity-[0.14] mix-blend-overlay" aria-hidden="true">
          <filter id={`grain-${tone}`}>
            <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" />
          </filter>
          <rect width="100%" height="100%" filter={`url(#grain-${tone})`} />
        </svg>
        <div
          class:list={[
            'absolute inset-x-0 top-[38%] h-px',
            onDark ? 'bg-limestone/20' : 'bg-graphite/15',
          ]}
        />
        {hint && (
          <figcaption
            class:list={[
              'eyebrow absolute bottom-6 left-6 right-6 text-[0.5625rem] leading-relaxed',
              onDark ? 'text-limestone/70' : 'text-graphite/70',
            ]}
          >
            {hint}
          </figcaption>
        )}
      </div>
    )
  }
</figure>
