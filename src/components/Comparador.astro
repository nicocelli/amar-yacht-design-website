---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Comparador antes/depois com máscara arrastável.
 *
 * O controle é um <input type="range"> transparente cobrindo a área inteira:
 * ganhamos arraste com mouse, toque, teclado (setas) e semântica de leitor de
 * tela sem reimplementar nada. Sem JS, o range continua funcionando — só não
 * atualiza a máscara, e o "antes" fica visível por inteiro.
 */
interface Props {
  id: string;
  legenda: string;
  antes: { src: ImageMetadata; alt: string };
  depois: { src: ImageMetadata; alt: string };
  larguras: number[];
  tamanhos: string;
  /** Proporção do recorte. Quadrado mantém o bloco compacto. */
  proporcao?: string;
  /**
   * object-position aplicado às duas fotos. As originais são retratos altos e a
   * mudança que interessa (o piso) está na parte de baixo — centralizar o
   * recorte cortaria justamente ela.
   */
  posicao?: string;
  class?: string;
}

const {
  id,
  legenda,
  antes,
  depois,
  larguras,
  tamanhos,
  proporcao = 'aspect-square',
  posicao = 'center 60%',
  class: className = '',
} = Astro.props;
---

<div
  class:list={['comparador relative w-full cursor-ew-resize touch-pan-y overflow-hidden rounded-media bg-sand select-none', proporcao, className]}
  data-comparador
  style="--pos:50%"
>
  <Image
    src={antes.src}
    alt={antes.alt}
    widths={larguras}
    sizes={tamanhos}
    loading="lazy"
    decoding="async"
    style={`object-position:${posicao}`}
    class="absolute inset-0 size-full object-cover"
  />

  <Image
    src={depois.src}
    alt={depois.alt}
    widths={larguras}
    sizes={tamanhos}
    loading="lazy"
    decoding="async"
    style={`object-position:${posicao}`}
    class="comparador-depois absolute inset-0 size-full object-cover"
  />

  <!-- rótulos: cada um some quando sua faixa fica estreita demais para lê-lo -->
  <span
    class="eyebrow pointer-events-none absolute top-4 left-4 z-2 rounded-full bg-limestone/90 px-3.5 py-2 text-ocean"
    >Antes</span
  >
  <span
    class="eyebrow pointer-events-none absolute top-4 right-4 z-2 rounded-full bg-ocean/90 px-3.5 py-2 text-limestone"
    >Depois</span
  >

  <!-- divisor + pega -->
  <div class="comparador-linha pointer-events-none absolute inset-y-0 z-2 w-px bg-limestone">
    <span
      class="absolute top-1/2 left-1/2 flex size-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-limestone text-ocean shadow-[0_2px_12px_rgba(14,42,61,0.28)]"
    >
      <svg width="22" height="10" viewBox="0 0 22 10" fill="none" aria-hidden="true">
        <path d="M8 1L4 5l4 4M14 1l4 4-4 4" stroke="currentColor" stroke-width="1.25"></path>
      </svg>
    </span>
  </div>

  <input
    type="range"
    min="0"
    max="100"
    value="50"
    step="1"
    id={id}
    aria-label={`Comparar antes e depois: ${legenda}`}
    class="comparador-controle absolute inset-0 z-3 size-full cursor-ew-resize appearance-none bg-transparent"
  />
</div>

<style>
  .comparador-depois {
    clip-path: inset(0 0 0 var(--pos));
  }

  .comparador-linha {
    left: var(--pos);
  }

  /* O range cobre a área toda e fica invisível: o "polegar" visível é a pega
     desenhada acima. Mantém foco de teclado sem duplicar o controle. */
  /* O range existe para teclado e leitor de tela. O ponteiro é tratado no
     contêiner: o Safari do iOS só inicia arraste em cima do polegar do range,
     que aqui é invisível — no iPhone o comparador só respondia a toque solto. */
  .comparador-controle {
    margin: 0;
    outline-offset: -2px;
    pointer-events: none;
  }
  .comparador-controle::-webkit-slider-thumb {
    appearance: none;
    width: 44px;
    height: 100%;
    background: transparent;
    cursor: ew-resize;
  }
  .comparador-controle::-moz-range-thumb {
    width: 44px;
    height: 100%;
    border: 0;
    background: transparent;
    cursor: ew-resize;
  }
  .comparador-controle::-moz-range-track {
    background: transparent;
  }
</style>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-comparador]')) {
    const range = box.querySelector<HTMLInputElement>('.comparador-controle');
    if (!range) continue;

    const aplicar = () => box.style.setProperty('--pos', `${range.value}%`);

    /** posiciona a máscara pelo x do ponteiro, em porcentagem da largura */
    const seguir = (x: number) => {
      const caixa = box.getBoundingClientRect();
      if (!caixa.width) return;
      const pct = ((x - caixa.left) / caixa.width) * 100;
      range.value = String(Math.min(Math.max(pct, 0), 100));
      aplicar();
    };

    // teclado (setas) continua vindo do próprio range
    range.addEventListener('input', aplicar);

    box.addEventListener('pointerdown', (evento) => {
      box.setPointerCapture(evento.pointerId);
      seguir(evento.clientX);
    });

    box.addEventListener('pointermove', (evento) => {
      if (!box.hasPointerCapture(evento.pointerId)) return;
      // com a captura ativa, o arraste horizontal é nosso; touch-pan-y no CSS
      // preserva a rolagem vertical da página
      evento.preventDefault();
      seguir(evento.clientX);
    });

    const soltar = (evento: PointerEvent) => {
      if (box.hasPointerCapture(evento.pointerId)) box.releasePointerCapture(evento.pointerId);
    };
    box.addEventListener('pointerup', soltar);
    box.addEventListener('pointercancel', soltar);

    aplicar();
  }
</script>
