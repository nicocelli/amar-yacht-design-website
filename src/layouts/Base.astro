---
import '../styles/global.css';
import { brand, contact, SITE_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Caminho da imagem OG dentro de /public */
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE_URL).href;
const ogUrl = new URL(ogImage, SITE_URL).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#business`,
  name: brand.name,
  alternateName: brand.shortName,
  url: SITE_URL,
  description:
    'Estúdio de design especializado em interiores náuticos, projetos e refit de embarcações.',
  slogan: brand.tagline,
  image: ogUrl,
  telephone: contact.phoneHref,
  areaServed: { '@type': 'Country', name: 'Brasil' },
  address: {
    '@type': 'PostalAddress',
    addressRegion: brand.region,
    addressCountry: brand.country,
  },
  founder: {
    '@type': 'Person',
    name: brand.founder,
    jobTitle: brand.role,
  },
  sameAs: [contact.instagramUrl],
  knowsAbout: [
    'Design de interiores náuticos',
    'Refit de embarcações',
    'Layout e otimização de espaços a bordo',
    'Marcenaria náutica',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Serviços A·MAR Yacht Design',
    itemListElement: [
      'Projetos de interiores náuticos',
      'Refit de embarcações',
      'Layout e otimização de espaços',
      'Consultoria de materiais e acabamentos',
    ].map((n) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: n },
    })),
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F6F4EF" />

    <link
      rel="preload"
      href="/fonts/cormorant-garamond-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <script is:inline>
      // Marca que o JS está ativo antes da primeira pintura, para que .reveal só
      // esconda conteúdo quando houver quem o revele depois.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-ocean focus:px-6 focus:py-3 focus:text-limestone"
    >
      Pular para o conteúdo
    </a>

    <slot />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
