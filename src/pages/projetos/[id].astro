---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { publishedProjects } from '../../lib/projetos';
import { publishedPosts } from '../../lib/blog';
import { SITE_URL } from '../../data/site';

export async function getStaticPaths() {
  return (await publishedProjects()).map((projeto) => ({ params: { id: projeto.id }, props: { projeto } }));
}
interface Props { projeto: CollectionEntry<'projetos'> }
const { projeto } = Astro.props;
const { Content } = await render(projeto);
const d = projeto.data;

// O link para o artigo só aparece se o artigo estiver publicado.
const artigo = d.artigo ? (await publishedPosts()).find((post) => post.id === d.artigo) : undefined;

const ficha = [
  { termo: 'Embarcação', valor: d.embarcacao },
  { termo: 'Escopo', valor: d.tipo },
  { termo: 'Ambientes', valor: d.ambientes.join(', ') },
  { termo: 'Ano', valor: String(d.ano) },
  { termo: 'Local', valor: d.local ?? '' },
  { termo: 'Natureza', valor: d.natureza },
].filter((item) => item.valor);

const schema = {
  '@context': 'https://schema.org', '@type': 'CreativeWork',
  name: d.title, description: d.description, dateCreated: String(d.ano),
  image: `${SITE_URL}${d.capa}`,
  creator: { '@type': 'Organization', name: 'A·MAR Yacht Design', url: SITE_URL },
  url: `${SITE_URL}/projetos/${projeto.id}`,
};
---
<Base title={`${d.title} | Projetos A·MAR`} description={d.description}>
  <Nav />
  <main id="conteudo" class="wrap pb-20 pt-36 md:pt-44">
    <article>
      <a href="/projetos" class="eyebrow underline underline-offset-4">← Todos os projetos</a>
      <header class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">{d.tipo}</p>
          <h1 class="display-lg mt-5">{d.title}</h1>
          <p class="lede mt-6 max-w-[48ch]">{d.description}</p>
          {d.natureza !== 'Projeto executado' && (
            <p class="mt-6 inline-block rounded-full border border-taupe/70 px-4 py-1.5 text-xs uppercase tracking-[0.15em] text-ink-muted">{d.natureza}</p>
          )}
        </div>
        <dl class="self-end border-t border-taupe/50 lg:col-span-5">
          {ficha.map((item) => (
            <div class="flex justify-between gap-6 border-b border-taupe/30 py-3 text-sm">
              <dt class="text-ink-muted">{item.termo}</dt>
              <dd class="text-right text-graphite">{item.valor}</dd>
            </div>
          ))}
        </dl>
      </header>

      <img src={d.capa} alt={d.capaAlt} decoding="async" class="mt-12 aspect-[16/9] w-full rounded-media object-cover" />

      <div class="project-body mx-auto mt-14 max-w-3xl"><Content /></div>

      {artigo && (
        <aside class="mx-auto mt-14 max-w-3xl rounded-card border border-taupe/50 p-8">
          <p class="eyebrow">No blog</p>
          <p class="mt-3 font-display text-2xl">{artigo.data.title}</p>
          <a href={`/blog/${artigo.id}`} class="mt-4 inline-block text-ocean underline underline-offset-4">Ler o artigo completo →</a>
        </aside>
      )}

      <aside class="mx-auto mt-10 max-w-3xl rounded-card bg-sand/55 p-8">
        <h2 class="display-md">Vamos pensar no seu barco?</h2>
        <p class="mt-4">Converse com a A·MAR sobre as possibilidades para os seus interiores.</p>
        <a href="/#contato" class="mt-5 inline-block text-ocean underline underline-offset-4">Iniciar uma conversa →</a>
      </aside>
    </article>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </main>
  <Footer />
</Base>
<style>
  .project-body { line-height: 1.85; overflow-wrap: anywhere; }
  .project-body :global(p), .project-body :global(ul), .project-body :global(ol) { margin-block: 1.25rem; }
  .project-body :global(h2) { margin-top: 2.75rem; font-size: clamp(1.8rem, 3vw, 2.5rem); }
  .project-body :global(h3) { margin-top: 2rem; font-size: 1.7rem; }
  .project-body :global(a) { color: var(--color-ocean); text-decoration: underline; text-underline-offset: 4px; }
  .project-body :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .project-body :global(li) { margin-block: .5rem; }
  .project-body :global(img) { border-radius: var(--radius-media); margin-block: 2rem .5rem; width: 100%; }
  .project-body :global(blockquote) { border-left: 2px solid var(--color-oak); padding: .25rem 0 .25rem 1.5rem; color: var(--color-ink-muted); font-size: .9375rem; }
  .project-body :global(blockquote strong) { color: var(--color-graphite); }
  .project-body :global(em) { color: var(--color-ink-muted); font-size: .875rem; }
</style>
