---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Sobre from '../components/sections/Sobre.astro';
import Interiores from '../components/sections/Interiores.astro';
import Refit from '../components/sections/Refit.astro';
import AntesDepois from '../components/sections/AntesDepois.astro';
import Metodo from '../components/sections/Metodo.astro';
import Assinatura from '../components/sections/Assinatura.astro';
// Fora do ar por ora — os componentes seguem no projeto, prontos para voltar.
// import Parcerias from '../components/sections/Parcerias.astro';
// import Marcas from '../components/sections/Marcas.astro';
import Contato from '../components/sections/Contato.astro';
---

<Base
  title="A·MAR Yacht Design | Interiores náuticos, refit e layout de embarcações"
  description="Seu barco pode ser o seu lugar favorito. Estúdio de design especializado em interiores náuticos, projetos e refit de embarcações em Santa Catarina."
>
  <Nav />
  <main id="conteudo">
    <Hero />
    <Sobre />
    <Interiores />
    <Refit />
    <AntesDepois />
    <Metodo />
    <Assinatura />
    {/* <Parcerias /> */}
    {/* <Marcas /> */}
    <Contato />
  </main>
  <Footer />
</Base>
